# 部署到 Vercel 時，把以下貼入 Vercel → Settings → Environment Variables
# （Production + Preview + Development 全勾）

NEXT_PUBLIC_SUPABASE_URL=        ← 填入
NEXT_PUBLIC_SUPABASE_ANON_KEY=   ← 填入
SUPABASE_SERVICE_ROLE_KEY=       ← 填入

NEXTAUTH_URL=https://admin.urland.com.tw
NEXTAUTH_SECRET=                 ← 填入（用 `openssl rand -hex 32` 產生）

ADMIN_EMAIL=                     ← 填入
ADMIN_PASSWORD_HASH=             ← 填入（用 scripts/hash-password.mjs 產生）

RESEND_API_KEY=                  ← 填入
RESEND_FROM_EMAIL=noreply@send.urland.com.tw
RESEND_FROM_NAME=Urland
